package modals

import (
	"gocas/modules/admins/users/entity"
	"strconv"
)

templ UserCreateModal(roles []entity.Role) {
<div class="modal fade" id="create_user_modal" tabindex="-1" aria-labelledby="create_user_modal_label"
	aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content border-0">
			<div class="modal-header bg-soft-info p-3">
				<h5 class="modal-title" id="create_user_modal_label" data-key="t-add-user">Thêm người dùng</h5>
				<button type="button" class="btn-close close-modal" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<form class="tablelist-form" id="create_user_form" autocomplete="off">
				<div class="modal-body">
					<div class="row g-3">
						<div class="col-lg-12">
							<div>
								<label for="userEmail" class="form-label"><span data-key="t-email">Email</span> <span
										class="text-danger">*</span></label>
								<input type="email" class="form-control" id="userEmail" name="email" required
									placeholder="Nhập email" />
							</div>
						</div>
						<div class="col-lg-6">
							<div>
								<label for="userFirstName" class="form-label"><span data-key="t-first-name">Tên</span> <span
										class="text-danger">*</span></label>
								<input type="text" class="form-control" id="userFirstName" name="first_name" required
									placeholder="Nhập tên" />
							</div>
						</div>
						<div class="col-lg-6">
							<div>
								<label for="userLastName" class="form-label"><span data-key="t-last-name">Họ</span> <span
										class="text-danger">*</span></label>
								<input type="text" class="form-control" id="userLastName" name="last_name" required
									placeholder="Nhập họ" />
							</div>
						</div>

						<div class="col-lg-6">
							<label class="form-label">Vai trò <span class="text-danger">*</span></label>
							<div>
								<select class="form-select" id="userRole" name="role_id" required>
									for _, r := range roles {
										<option value={strconv.FormatInt(r.ID, 10)}>{r.Name}</option>
									}
								</select>
							</div>
						</div>

						<div class="col-lg-6">
							<label class="form-label">Trạng thái <span class="text-danger">*</span></label>
							<div class="mt-lg-0 mt-2">
								<div class="form-check form-check-inline form-radio-secondary mb-2">
									<input class="form-check-input" type="radio" name="status" id="userStatusActive" value="1" checked />
									<label class="form-check-label text-capitalize" for="userStatusActive" data-key="t-active">Hiện</label>
								</div>
								<div class="form-check form-check-inline mb-2">
									<input class="form-check-input" type="radio" name="status" id="userStatusInactive" value="2" />
									<label class="form-check-label text-capitalize" for="userStatusInactive" data-key="t-inactive">Ẩn</label>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="modal-footer" style="display: block;">
					<div class="hstack gap-2 justify-content-end">
						<button type="button" class="btn btn-light close-modal" data-bs-dismiss="modal"
							data-key="t-close">Đóng</button>
						<button type="button" class="btn btn-success" id="save_user_btn"
							data-key="t-submit-create">Xác nhận</button>
					</div>
				</div>
			</form>
		</div>
	</div>
</div>
}
