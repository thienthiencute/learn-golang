package users_group

import (
"gocas/views/layouts"
"gocas/pkg/golangviet/templates"
)

templ Index(){
@layouts.Master(&[]templ.Component{head()}, scriptSlot()){
<div class="row">
	<div class="col-12">
		<div class="page-title-box d-sm-flex align-items-center justify-content-between">
			<h4 data-key="t-admin">Admin</h4>
			<div class="page-title-right">
				<ol class="breadcrumb m-0">
					<li class="breadcrumb-item"><a href="javascript: void(0);" data-key="t-users-group">Users Group</a></li>
					<li class="breadcrumb-item active" data-key="t-list">List</li>
				</ol>
			</div>
		</div>
	</div>
</div>

<div class="row">
	<div class="col-xxl-9">
		<div class="col-lg-12">
			<div class="card" id="userGroupList">
				<div class="w-100 card-body border-end-0 border-start-0 d-lg-flex align-items-center justify-content-between">
					<div class="row align-items-center gy-3 w-100">
						<div class="col-sm">
							<h5 class="card-title mb-0" data-key="t-user-group-list">User Group List</h5>
						</div>
						<div class="col-sm-auto d-lg-flex gap-2 align-items-center justify-content-center">
							<button type="button" class="btn btn-secondary add-btn" data-bs-toggle="modal"
								data-bs-target="#create_user_group_modal" id="create-btn"><i class="mdi mdi-plus"></i><span
									data-key="t-add-user-group">Add User Group</span></button>
						</div>
					</div>
				</div>

				<div class="card-body pt-2">
					<div>
						<div class="table-responsive table-card mb-1">
							<table class="table table-hover align-middle m-0" id="user_group_table"
								data-domain={templates.AssetURL("")} style="min-height: 200px;width:100%">
								<thead class="table-light text-muted">
									<tr class="text-uppercase">
										<th>ID</th>
										<th>Name</th>
										<th>Description</th>
										<th>Status</th>
										<th>Action</th>
									</tr>
								</thead>
							</table>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
	
	<!-- Modal -->
	<div class="modal fade" id="create_user_group_modal" tabindex="-1" aria-labelledby="create_user_group_modal_label" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content border-0">
				<div class="modal-header bg-soft-info p-3">
					<h5 class="modal-title" id="create_user_group_modal_label" data-key="t-add-user-group">Thêm nhóm người dùng</h5>
					<button type="button" class="btn-close close-modal" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<form class="tablelist-form" id="create_user_group_form" autocomplete="off">
					<div class="modal-body">
						<div class="row g-3">
							<div class="col-lg-12">
								<div>
									<label for="groupName" class="form-label"><span data-key="t-name">Tên nhóm</span> <span class="text-danger">*</span></label>
									<input type="text" class="form-control" id="groupName" name="name" required placeholder="Nhập tên nhóm" />
								</div>
							</div>
							<div class="col-lg-12">
								<div>
									<label for="groupDesc" class="form-label"><span data-key="t-description">Mô tả</span></label>
									<textarea class="form-control" id="groupDesc" name="description" placeholder="Nhập mô tả"></textarea>
								</div>
							</div>
							<div class="col-lg-12">
								<div class="form-check form-switch form-switch-right form-switch-md">
									<label for="groupStatus" class="form-label text-muted">Trạng thái (Hoạt động)</label>
									<input class="form-check-input code-switcher" type="checkbox" id="groupStatus" name="status" checked>
								</div>
							</div>
						</div>
					</div>
					<div class="modal-footer" style="display: block;">
						<div class="hstack gap-2 justify-content-end">
							<button type="button" class="btn btn-light close-modal" data-bs-dismiss="modal" data-key="t-close">Đóng</button>
							<button type="button" class="btn btn-success" id="save_user_group_btn" data-key="t-submit-create">Xác nhận</button>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>

}
}

templ head(){
<link rel="stylesheet" href={ templates.AssetURL("/static/themes/libs/datatables/datatables.min.css") } />
}

templ scriptSlot(){
<script type="text/javascript" src={ templates.AssetURL("/static/themes/libs/datatables/datatables.min.js") } defer></script>
<script type="module" src={ templates.AssetURL("/static/js/admins/users_group/list.js") } defer></script>
}
